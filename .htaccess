# The landing is the static Next.js export (index.html). Serve it first.
DirectoryIndex index.html index.php

# Defense-in-depth: never serve secrets or the database, even if the data/
# directory ends up somewhere the per-directory rule doesn't apply.
<FilesMatch "\.(sqlite|sqlite3|db|sqlite-wal|sqlite-shm|log)$">
  Require all denied
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<Files "config.php">
  Require all denied
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
