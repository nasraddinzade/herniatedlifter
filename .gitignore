# NOTE: config.php (admin hash + salt) is committed on purpose so Hostinger's
# Git auto-deploy delivers it to the server. This is safe only because the repo
# is PRIVATE. If you ever make it public, rotate the password (regenerate
# ADMIN_PASSWORD_HASH) and keep config.php out of git instead.

# Runtime data: SQLite database, WAL/SHM sidecars, logs.
# Keep the directory's .htaccess guard tracked, ignore everything else.
/data/*
!/data/.htaccess

# Next.js client: source lives in client/, and the built static export is
# copied to the repo root and committed. Ignore only the build tooling output.
client/node_modules/
client/.next/
client/out/

# OS junk
.DS_Store
Thumbs.db
